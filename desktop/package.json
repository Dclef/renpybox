{
  "name": "renpybox-desktop",
  "version": "0.9.0",
  "private": true,
  "author": "dclef",
  "type": "module",
  "description": "RenpyBox Electron shell —— Electron 主进程 + Python sidecar（FastAPI + WebSocket）+ React/TS 主 UI",
  "main": "main/main.js",
  "scripts": {
    "start": "node scripts/run-electron.mjs .",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "dev:shell": "node scripts/run-electron.mjs .",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "sidecar": "node scripts/sidecar.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:window-close": "node scripts/run-electron.mjs scripts/check-window-close.cjs",
    "check:window-recovery": "node scripts/run-electron.mjs scripts/check-window-recovery.cjs",
    "check:font-parity": "node scripts/run-electron.mjs scripts/check-font-parity.cjs",
    "check:desktop-dialogs": "node scripts/run-electron.mjs scripts/check-desktop-dialogs.cjs --workflows",
    "check:toolbox-ui": "node scripts/run-electron.mjs scripts/check-toolbox-ui.cjs",
    "check:translation-parity": "node scripts/run-electron.mjs scripts/check-translation-parity.cjs",
    "check:logs-shell": "node scripts/run-electron.mjs scripts/check-logs-shell.cjs",
    "check:ui": "node scripts/run-electron.mjs scripts/check-ui.cjs",
    "check:tool-layout": "node scripts/run-electron.mjs scripts/check-tool-layout.cjs",
    "check:rpy-parity": "node scripts/run-electron.mjs scripts/check-rpy-parity.cjs",
    "check:modes-parity": "node scripts/run-electron.mjs scripts/check-modes-parity.cjs",
    "check:modes-owner-parity": "node scripts/run-electron.mjs scripts/check-modes-owner-parity.cjs",
    "check:extract-parity": "node scripts/run-electron.mjs scripts/check-extract-parity.cjs",
    "check:engineering-core-parity": "node scripts/run-electron.mjs scripts/check-engineering-core-parity.cjs",
    "check:android-parity": "node scripts/run-electron.mjs scripts/check-android-parity.cjs",
    "check:crawl": "node scripts/run-electron.mjs scripts/check-crawl.cjs",
    "check:all": "npm run check:window-close && npm run check:window-recovery && npm run check:font-parity && npm run check:desktop-dialogs && npm run check:toolbox-ui",
    "pack:dir": "npm run build:backend && npm run build:renderer && electron-builder --dir --publish never && npm run verify:package",
    "pack:win": "npm run build:backend && npm run build:renderer && electron-builder --win nsis zip --x64 --publish never && npm run verify:package",
    "dist": "npm run pack:win"
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "antd": "6.6.5",
    "lucide-react": "^1.54.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "com.dclef.renpybox.newui",
    "productName": "RenpyBox New UI",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "../resource"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "shell/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../resource/icon.ico",
        "to": "renpybox/icon.ico"
      },
      {
        "from": "runtime/backend",
        "to": "backend"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "renpybox/CHANGELOG.md"
      },
      {
        "from": "../LICENSE",
        "to": "renpybox/LICENSE"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RenpyBox-NewUI-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}
