{
  "name": "renpybox-desktop",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "RenpyBox Electron shell —— Electron 主进程 + Python sidecar（FastAPI + WebSocket）+ React/TS 主 UI",
  "main": "main/main.js",
  "scripts": {
    "sidecar": "node scripts/sidecar.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "dev:shell": "electron .",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "start": "electron ."
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "antd": "^6.6.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
