{
  "name": "renpybox-desktop",
  "version": "0.0.0-spike.1",
  "private": true,
  "type": "module",
  "description": "RenpyBox Electron shell spike — 仿 DeepSeek Harness 壳工程模式（多 preload / vanilla 壳页 / WebSocket 单连接 / Python sidecar）",
  "main": "main/main.js",
  "scripts": {
    "sidecar": "sidecar\\.venv\\Scripts\\python.exe -m uvicorn main:app --app-dir sidecar --host 127.0.0.1 --port 9712",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "dev": "electron .",
    "perf-gate": "electron main/perf-gate.js"
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.1",
    "@tanstack/react-virtual": "^3.13.2",
    "@tanstack/vue-virtual": "^3.13.39",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^44.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vue": "^3.5.43"
  }
}
